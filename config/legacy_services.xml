<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service class="App\LegacyService\Feed\Storage\Doctrine" id="app.legacy_service.feed.storage.doctrine">
            <argument id="doctrine.orm.entity_manager" type="service"/>
        </service>

        <service class="App\LegacyService\Feed\Repository\F1VilagRepository"
                 id="app.legacy_service.feed.repository.f1_vilag_repository">
            <argument type="constant">App\LegacyService\Feed\Repository\F1VilagRepository::SOURCE</argument>
            <argument id="App\LegacyService\Feed\Collector\XMLCollector" type="service"/>
            <argument id="App\LegacyService\Feed\Image\WordPressFeaturedImages" type="service"/>
        </service>

        <service class="App\LegacyService\Feed\Handler" id="App\LegacyService\Feed\Handler">
            <argument type="collection">
                <argument id="app.legacy_service.feed.repository.f1_vilag_repository" type="service"/>
            </argument>
            <argument id="app.legacy_service.feed.storage.doctrine" type="service"/>
        </service>

        <service class="App\Builder\BetBuilder" id="App\Builder\BetBuilder">
            <argument id="App\Rule\RuleRegistry" type="service"/>
        </service>

    </services>

</container>
