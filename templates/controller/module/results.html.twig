{# Eredmények oldal: hétvégénként az összesítő, majd az eseménytáblák (ugyanaz a sorrend, mint az Aktuális oldalon) #}
<div id="results" class="f1-results">
    {% if weekends %}
        {% for key, weekend in weekends %}
            <section class="f1-weekend" data-round="{{ key }}">
                <h2 class="f1-weekend__title">
                    <span class="f1-weekend__round">{{ key }}. nagydíj</span>
                    {{ weekendNames[key] }}
                </h2>
                {% if weekend.summary is defined %}
                    {{ weekend.summary|raw }}
                {% endif %}
                {% for tableKey, table in weekend %}
                    {% if tableKey is not same as('summary') %}
                        {{ table|raw }}
                    {% endif %}
                {% endfor %}
            </section>
        {% endfor %}
    {% else %}
        {% include('controller/module/no_results.html.twig') %}
    {% endif %}
</div>
