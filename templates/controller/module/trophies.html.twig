{% extends 'controller/module/base_module.html.twig' %}
{% import 'macro/trophy.html.twig' as trophy %}
{% block heading_tag %}{{ 'trophy_trophies'|trans }}{% endblock %}
{% block heading_title %}
    {% if event %}{{ event.name|length > 20 ? event.name|split(' - ').0 : event.name }}{% endif %}
{% endblock %}
{% block body_content %}
    {% if event %}
        {% for type, trophies in podium_trophies %}
            <div class="f1-row">
                <div class="f1-pos">{{ trophy.icon(type, null, ('trophy_type_' ~ type)|trans) }}</div>
                <div class="f1-name f1-name--plain">
                    {%- for t in trophies %}{% if t.getUser() %}{{ t.getUser().getName() }}{{ loop.last ? '' : ', ' }}{% endif %}{% endfor -%}
                </div>
                <div class="f1-nums"><span class="f1-num f1-num--main">{{ trophies|first.getPoint() }}</span></div>
            </div>
        {% endfor %}
    {% else %}
        {% include ('controller/module/no_results.html.twig') %}
    {% endif %}
{% endblock %}
