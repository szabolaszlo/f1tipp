{% extends '@EasyAdmin/page/content.html.twig' %}

{#
 Az ea_url() egyetlen, kérésen belül megosztott generátor: minden link előtt unsetAll(), a végrehajtó űrlap címét
 pedig elsőként (a mostani kérés paramétereivel) kérjük le, mielőtt a linkek átírnák.
#}
{% macro check(item, links) %}
    {% set icons = {ok: '✓', fail: '✗', info: 'ℹ', neutral: '–', manual: '☐'} %}
    {% set colors = {ok: 'text-success', fail: 'text-danger', info: 'text-info', neutral: 'text-muted', manual: 'text-muted'} %}
    <li class="mb-1" data-check="{{ item.key }}" data-status="{{ item.status }}">
        <span class="{{ colors[item.status] }} fw-bold me-1" aria-hidden="true">{{ icons[item.status] }}</span>
        <span>{{ item.label }}</span>
        {% if item.detail is not null %}<small class="text-muted ms-1">{{ item.detail }}</small>{% endif %}
        {% if links[item.key] is defined %}
            <a href="{{ links[item.key].url }}" class="ms-2 text-nowrap">{{ links[item.key].label }} →</a>
        {% endif %}
    </li>
{% endmacro %}

{% block content_title %}{{ 'admin_maintenance_season_reset'|trans }}{% endblock %}

{% block main %}
    {% set execute_url = ea_url().setRoute('season_reset_execute').generateUrl() %}
    {% set admin = 'App\\Controller\\Admin\\' %}
    {% set links = {
        archive: {label: 'Információk', url: ea_url().unsetAll().setController(admin ~ 'InformationCrudController').setAction('new').generateUrl()},
        stale_events: {label: 'Események', url: ea_url().unsetAll().setController(admin ~ 'EventCrudController').setAction('index').generateUrl()},
        championship_points: {label: 'Bajnoki pontok', url: ea_url().unsetAll().setController(admin ~ 'ChampionshipPointCrudController').setAction('index').generateUrl()},
        prize: {label: 'Nyeremény', url: ea_url().unsetAll().setController(admin ~ 'PrizeDrawCrudController').setAction('edit').setEntityId(constant('App\\Entity\\PrizeDraw::ID')).generateUrl()},
        participants: {label: 'Felhasználók', url: ea_url().unsetAll().setController(admin ~ 'UserCrudController').setAction('index').generateUrl()},
        drivers_without_team: {label: 'Pilóták', url: ea_url().unsetAll().setController(admin ~ 'DriverCrudController').setAction('index').generateUrl()},
        rules_title: {label: 'Szabályzat', url: ea_url().unsetAll().setController(admin ~ 'InformationCrudController').setAction('edit').setEntityId(constant('App\\Season\\SeasonChecklist::RULES_INFORMATION_ID')).generateUrl()},
        driver_sync: {label: 'Pilóták', url: ea_url().unsetAll().setController(admin ~ 'DriverCrudController').setAction('index').generateUrl()},
    } %}

    <section id="season-checklist-before" class="mb-4">
        <h2 class="h4">1. Szezon végén (nullázás előtt)</h2>
        <ul class="list-unstyled">
            {% for item in checklist.before_reset %}{{ _self.check(item, links) }}{% endfor %}
        </ul>
    </section>

    <section id="season-reset" class="mb-4">
        <h2 class="h4">2. Szezon nullázása{% if facts.closingYear is not null %} – {{ facts.closingYear }}{% endif %}</h2>

        <p class="mb-1">Ezek törlődnek:</p>
        <ul id="season-reset-counts">
            <li data-count="bet">{{ facts.counts.bets }} tipp</li>
            <li data-count="result">{{ facts.counts.results }} eredmény</li>
            <li data-count="trophy">{{ facts.counts.trophies }} kupa</li>
            <li data-count="alternative">{{ facts.counts.alternatives }} alternatív pont-sor</li>
            <li data-count="user">{{ facts.counts.users }} felhasználó pontjai</li>
        </ul>

        <p id="season-reset-keeps">
            <strong>Megmarad:</strong> események, felhasználók, „bajnokság tagja” jelölés, pilóták, bajnoki pontok,
            nyeremény, információk, beállítások, üzenőfal
        </p>

        {% if warnings is not empty %}
            <ul id="season-reset-warnings" class="text-warning">
                {% for warning in warnings %}
                    <li>{{ warning }}</li>
                {% endfor %}
            </ul>
        {% endif %}

        {% if blocks is not empty %}
            <ul id="season-reset-blocks" class="text-danger">
                {% for block in blocks %}
                    <li>{{ block }}</li>
                {% endfor %}
            </ul>
        {% else %}
            {# a gomb a beküldéskor letiltódik: a dupla kattintás második POST-ja a már beváltott kóddal ellentmondó üzenetet adna #}
            <form method="post" action="{{ execute_url }}" class="d-flex align-items-center gap-3"
                  onsubmit="this.querySelector('#season-reset-submit').disabled = true">
                <input type="hidden" name="_token" value="{{ csrf_token('season_reset') }}">
                <span>Kód: <strong id="season-reset-code">{{ code }}</strong></span>
                <input type="text" id="season-reset-code-input" name="code" class="form-control w-auto" inputmode="numeric"
                       autocomplete="off" maxlength="6" required>
                <button type="submit" id="season-reset-submit" class="btn btn-danger">Szezon nullázása</button>
            </form>
        {% endif %}
    </section>

    <section id="season-checklist-new-season" class="mb-4">
        <h2 class="h4">3. Új szezon előtt</h2>
        <ul class="list-unstyled">
            {% for item in checklist.new_season %}{{ _self.check(item, links) }}{% endfor %}
        </ul>
    </section>

    <section id="season-checklist-after-first-race" class="mb-4">
        <h2 class="h4">4. Az első futam után</h2>
        <ul class="list-unstyled">
            {% for item in checklist.after_first_race %}{{ _self.check(item, links) }}{% endfor %}
        </ul>
    </section>

    <p class="text-muted small">
        ✓ ✗ élő ellenőrzés · ℹ élő információ ítélet nélkül · ☐ kézi emlékeztető (nem pipálható, nem tárolunk állapotot)
    </p>
{% endblock %}
