{# Eseménytábla tippelés alatt: csak az látszik, ki tippelt már. Változók: event, bets, ... #}
{% extends 'extension/result_table/type/full.html.twig' %}
{% block body_content %}
    <div class="f1-board__note">
        {% if bets|length %}
            <strong>{{ 'result_betting_user'|trans }}</strong>
            {%- for bet in bets %}{{ bet.getUser().getName() }}{{ loop.last ? '' : ', ' }}{% endfor %}
        {% else %}
            {{ 'result_betting_nobody'|trans }}
        {% endif %}
    </div>
    <input type="hidden" id="event-table-bet-numbers" value="{{ bets|length }}">
    <input type="hidden" id="event-table-event-id" value="{{ event.getId() }}">
{% endblock %}
