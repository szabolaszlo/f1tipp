{# Eseménytábla eredmény előtt: a leadott tippek semleges chipekkel. Változók: event, bets, ... #}
{% extends 'extension/result_table/type/full.html.twig' %}
{% block body_content %}
    {% if bets is not empty %}
        <div class="f1-tiprow f1-tiprow--head">
            <div></div>
            <div class="f1-name">{{ 'result_name'|trans }}</div>
            <div class="f1-chips" style="{{ gridStyle }}">
                {% for attribute in (bets|first).getAttributes() %}
                    <div>{{ ('result_' ~ attribute.getKey())|trans }}</div>
                {% endfor %}
            </div>
            <div></div>
        </div>
        {% for bet in bets %}
            <div class="f1-tiprow">
                <div></div>
                <div class="f1-name">{{ bet.getUser().getName() }}</div>
                <div class="f1-chips" style="{{ gridStyle }}">
                    {% for attribute in bet.getAttributes() %}
                        <div class="f1-chip f1-chip--plain{{ loop.index0 >= legend.positions ? ' f1-chip--q' : '' }}">{{ attribute.getValue() }}</div>
                    {% endfor %}
                </div>
                <div></div>
            </div>
        {% endfor %}
    {% else %}
        <div class="f1-board__note">{{ 'result_betting_nobody'|trans }}</div>
    {% endif %}
    <input type="hidden" id="event-table-bet-numbers" value="{{ bets|length }}">
    <input type="hidden" id="event-table-event-id" value="{{ event.getId() }}">
{% endblock %}
