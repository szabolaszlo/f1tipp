{# Hétvégi összesítő: hétvégi (gyűjtött) pont -> sorrend -> bajnoki (átváltott) pont. Változó: result (AlternativeChampionship[]) #}
{% if result is not empty %}
    {% set ranks = competition_ranks(result|map(ac => ac.getCollectedPoints)) %}
    <div class="f1-board f1-board--summary">
        <div class="f1-board__head">
            <span class="f1-board__tag">{{ 'general_weekend'|trans|upper }}</span>
            <span class="f1-board__title">{{ result.0.race.name|split(' - ').0 }} · Összesített eredmény</span>
            <span class="f1-board__meta">{{ result|length }} tippelő</span>
        </div>
        <div class="f1-board__colhead">
            <span>{{ ('alternativeChampionship_name')|trans }}</span>
            <span class="f1-nums">
                <span class="f1-num f1-num--wide">{{ ('alternativeChampionship_collected_points')|trans }}</span>
                <span class="f1-num f1-num--wide">{{ ('alternativeChampionship_converted_points')|trans }}</span>
            </span>
        </div>
        {% for ac in result %}
            {% set rank = ranks[loop.index0] %}
            <div class="f1-row">
                <div class="f1-pos{{ rank == 1 ? ' f1-pos--leader' : (rank <= 3 ? ' f1-pos--p' ~ rank : '') }}">{{ rank }}</div>
                <div class="f1-name">{{ ac.getUser.getName }}</div>
                <div class="f1-nums">
                    <span class="f1-num f1-num--wide f1-num--dim">{{ ac.getCollectedPoints }}</span>
                    <span class="f1-num f1-num--wide f1-num--main">{{ ac.getPoints > 0 ? '+' ~ ac.getPoints : ac.getPoints }}</span>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
