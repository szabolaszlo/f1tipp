{# Eseménytábla eredménnyel ("TV-grafika"). Változók: result, bets, usersCount, noBettingUsers, countableBets #}
{% set event = result is defined and result ? result.getEvent() : event %}
{% set legend = bet_legend(event.getType()) %}
{% set gridStyle = '--cols: ' ~ legend.positions ~ '; --q: ' ~ (legend.question is null ? 0 : 1) %}

<div class="f1-board f1-board--event">
    {% include 'extension/result_table/_board_head.html.twig' %}
    {% block body_content %}
        {% set ranks = competition_ranks(bets|map(b => b.getPointSummary())) %}
        <div class="f1-tiprow f1-tiprow--head">
            <div></div>
            <div class="f1-name">{{ 'result_name'|trans }}</div>
            <div class="f1-chips" style="{{ gridStyle }}">
                {% for attribute in result.getAttributes() %}
                    <div>{{ ('result_' ~ attribute.getKey())|trans }}</div>
                {% endfor %}
            </div>
            <div class="f1-tiprow__pts">{{ 'result_point'|trans }}</div>
        </div>
        <div class="f1-tiprow f1-tiprow--result">
            <div></div>
            <div class="f1-name">{{ 'general_result'|trans }}</div>
            <div class="f1-chips" style="{{ gridStyle }}">
                {% for attribute in result.getAttributes() %}
                    {% if loop.index0 < legend.positions %}
                        <div class="f1-chip f1-chip--res" style="border-left-color: {{ team_color(attribute.getValue()) }}">{{ attribute.getValue() }}</div>
                    {% else %}
                        <div class="f1-chip f1-chip--res f1-chip--q">{{ attribute.getValue() }}</div>
                    {% endif %}
                {% endfor %}
            </div>
            <div></div>
        </div>
        {% for bet in bets %}
            <div class="f1-tiprow">
                <div class="f1-pos">{{ ranks[loop.index0] }}</div>
                <div class="f1-name">{{ bet.getUser().getName() }}</div>
                <div class="f1-chips" style="{{ gridStyle }}">
                    {% for attribute in bet.getAttributes() %}
                        {% set mark = attribute.getClass() == 'bet-high' ? ' f1-chip--exact' : (attribute.getClass() == 'bet-low' ? ' f1-chip--near' : '') %}
                        <div class="f1-chip{{ mark }}{{ loop.index0 >= legend.positions ? ' f1-chip--q' : '' }}">{{ attribute.getValue() }}</div>
                    {% endfor %}
                </div>
                <div class="f1-tiprow__pts">{{ bet.getPointSummary() }}</div>
            </div>
        {% endfor %}
        {% if noBettingUsers is not empty %}
            <div class="f1-board__note">
                <strong>{{ 'result_no_betting_users'|trans }}</strong>{{ noBettingUsers|join(', ') }}
            </div>
        {% endif %}
        <div class="f1-legend">
            <span><span class="f1-chip f1-chip--exact">VER</span>Pontos hely · {{ legend.exact }} pont</span>
            {% if legend.near > 0 %}
                <span><span class="f1-chip f1-chip--near">NOR</span>Top {{ legend.positions }}-ben, rossz helyen · {{ legend.near }} pont</span>
            {% endif %}
            <span><span class="f1-chip">GAS</span>Nem talált · 0 pont</span>
            {% if legend.question is not null %}
                <span>SC: biztonsági autó kérdés · {{ legend.question }} pont</span>
            {% endif %}
        </div>
    {% endblock %}
</div>
