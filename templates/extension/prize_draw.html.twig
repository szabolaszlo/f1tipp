<div class="f1-board">
    <div class="f1-board__head">
        <span class="f1-board__tag">Nyeremény</span>
        <span class="f1-board__title">Összesített helyezés</span>
    </div>
    <div class="f1-board__colhead">
        <span>Helyezés</span>
        <span class="f1-nums"><span class="f1-num f1-num--wide">Összeg</span></span>
    </div>
    {% for place, amount in {1: '22,500', 2: '13,500', 3: '9,000'} %}
        <div class="f1-row">
            <div class="f1-pos f1-pos--p{{ place }}">{{ place }}</div>
            <div class="f1-name"></div>
            <div class="f1-nums"><span class="f1-num f1-num--wide f1-num--main">{{ amount }}</span></div>
        </div>
    {% endfor %}
    <div class="f1-board__note">11 résztvevő X 5000 = 55000 - 10000(üzemeltetés) = 45000</div>
</div>
