# E2E környezet (CodeceptJS tesztek): külön adatbázis, a dev adatokat nem érinti.
# Az nginx 81-es server blokkja (hoston: 8001) állítja be az APP_ENV=e2e-t.
APP_ENV=e2e
APP_DEBUG=1
DATABASE_URL=mysql://root:root@mysql_db:3306/f1tipp_e2e
RAPIDAPI_KEY=e2e-dummy
OAUTH_GOOGLE_WEB_ID=e2e
OAUTH_GOOGLE_WEB_SECRET=e2e
OAUTH_GOOGLE_WEB_REDIRECT_URI=http://127.0.0.1:8001/auth/google
